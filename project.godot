; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

script_name_on_top/hide_scripts_panel=false
script_name_on_top/hide_bottom_bar=false
script_name_on_top/show_bottom_bar_on_warning=true

[application]

config/name="toad-house"
run/main_scene="uid://y62j7pyn0s6u"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

JsBridge="*uid://x1i6r3dceyfw"
AudioManager="*uid://b8p2piq6wvkv7"
Title="*uid://y62j7pyn0s6u"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/inspector_tabs/plugin.cfg", "res://addons/sprout_lands_tilemap/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[sprout_lands_tilemap]

disable_plugin_dialogues=true
copy_path="res://extra-assets"

[sprout_lands_ui]

disable_plugin_dialogues=true
